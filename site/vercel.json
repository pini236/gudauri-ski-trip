{
  "cleanUrls": true,
  "buildCommand": "node -e \"const fs=require('fs'),p=require('path');const v=(process.env.VERCEL_GIT_COMMIT_SHA||'dev').slice(0,7);const pages=['index.html'].concat(fs.readdirSync('games',{withFileTypes:true}).filter(d=>d.isDirectory()&&fs.existsSync(p.join('games',d.name,'index.html'))).map(d=>p.join('games',d.name,'index.html')));for(const f of pages){const s=fs.readFileSync(f,'utf8');const t=s.replace(/<html([^>]*)>/,(m,a)=>'<html'+a.replace(/ data-version=\\\"[^\\\"]*\\\"/,'')+' data-version=\\\"'+v+'\\\">');if(t!==s)fs.writeFileSync(f,t);}console.log('stamped',pages.length,'pages with',v)\"",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/downloads/(.*).apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"gudauri-2027.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/j/:token",
      "destination": "/#join/:token",
      "permanent": false
    },
    {
      "source": "/join/:code",
      "destination": "/#join/:code",
      "permanent": false
    },
    {
      "source": "/account",
      "destination": "/#account/delete",
      "permanent": false
    }
  ]
}
