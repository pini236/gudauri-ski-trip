<?xml version="1.0" encoding="utf-8"?>
<!-- The test build's name under the icon and in the notification shade comes from i18n/strings.json (tester.app_name), so it
     follows the app's language (decision 47) instead of staying in Hebrew. The store build does not have this file. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application android:label="@string/tester_app_name" android:theme="@style/Gudi.Preview" tools:replace="android:label,android:theme">
        <!-- the new design's font chain (redesign part 7), made once at start; the test build only -->
        <provider
            android:name="io.github.pini236.skiapp.redesign.GudiFontInit"
            android:authorities="${applicationId}.gudifont"
            android:exported="false" />
    </application>
</manifest>
