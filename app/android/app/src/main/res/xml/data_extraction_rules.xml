<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of the app travels in a backup or to another phone (allowBackup is off); Android 12 and up also ask for this
     file. The ski days' folder is named on purpose, as the log of where a person skied must stay on the phone it was made
     on (docs/ARCHITECTURE.md m-8, condition 3). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="dayrec" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="dayrec" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
