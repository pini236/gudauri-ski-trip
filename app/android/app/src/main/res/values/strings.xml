<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's words (stage 13.2, the language structure). This default file is Hebrew, the first language: a phone in
  any language gets Hebrew until its own file exists. English, Russian and Georgian go in values-en, values-ru and
  values-ka with the same names; the languages session (i18n/) writes them, and StringsTest checks that every file
  has every name with the same placeholders. Each new language is also added to xml/locales_config.xml.
  The app's name comes from the build (app_name, per flavour).
-->
<resources>
